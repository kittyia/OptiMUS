{
  "background": "A simple production planning problem",
  "parameters": [
      {
          "definition": "profit per unit of product 1",
          "symbol": "profit1",
          "shape": []
      },
      {
          "definition": "profit per unit of product 2",
          "symbol": "profit2",
          "shape": []
      },
      {
          "definition": "available resource",
          "symbol": "resource",
          "shape": []
      }
  ],
  "constraints": [
      "5 * x1 + 3 * x2 <= resource",
      "x1 >= 0",
      "x2 >= 0"
  ],
  "objective": "Maximize  profit1 * x1 + profit2 * x2"
}
