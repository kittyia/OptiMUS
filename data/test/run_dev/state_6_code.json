{
    "description": "Maximize profit: 3x + 4y\nSubject to:\nx + 2y <= 8\n2x + y <= 10\nx, y >= 0\nx, y continuous",
    "parameters": {},
    "objective": {
        "description": "\"The goal is to maximize the profit\"",
        "formulation": "$\\max 3x + 4y$",
        "code": "model.setObjective(3*x + 4*y, GRB.MAXIMIZE"
    },
    "constraints": [
        {
            "description": "x + 2y <= 8",
            "formulation": "$x + 2y \\leq 8$",
            "code": "model.addConstr(x + 2*y <= 8)"
        },
        {
            "description": "2x + y <= 10",
            "formulation": "$2x + y \\leq 10$",
            "code": "model.addConstr(2*x + y <= 10)"
        },
        {
            "description": "x >= 0",
            "formulation": "$x \\\\geq 0$",
            "code": "model.addConstr(x >= 0)"
        },
        {
            "description": "y >= 0",
            "formulation": "$y \\\\geq 0$",
            "code": "model.addConstr(y >= 0)"
        }
    ],
    "variables": {}
}