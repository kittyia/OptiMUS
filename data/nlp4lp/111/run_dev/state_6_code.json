{
    "description": "A travelling salesman only eats ramen and fries. Each pack of ramen contains 400 calories, 20 grams of protein, and 100 mg of sodium. Each pack of fries contains 300 calories, 10 grams of protein, and 75 mg of sodium. Since fries are easier to eat while driving, at most 30% of his meals can be ramen. The salesman wants to ensure he eats at least 3000 calories and 80 grams of protein. How many of each should he eat to minimize his sodium intake?",
    "parameters": {
        "CaloriesPerRamenPack": {
            "definition": "Calories per pack of ramen",
            "shape": [],
            "type": "int"
        },
        "ProteinPerRamenPack": {
            "definition": "Protein per pack of ramen",
            "shape": [],
            "type": "int"
        },
        "SodiumPerRamenPack": {
            "definition": "Sodium per pack of ramen",
            "shape": [],
            "type": "int"
        },
        "CaloriesPerFriesPack": {
            "definition": "Calories per pack of fries",
            "shape": [],
            "type": "int"
        },
        "ProteinPerFriesPack": {
            "definition": "Protein per pack of fries",
            "shape": [],
            "type": "int"
        },
        "SodiumPerFriesPack": {
            "definition": "Sodium per pack of fries",
            "shape": [],
            "type": "int"
        },
        "MaxRamenMealRatio": {
            "definition": "Maximum proportion of meals that can be ramen",
            "shape": [],
            "type": "float"
        },
        "MinCalories": {
            "definition": "Minimum calories required",
            "shape": [],
            "type": "int"
        },
        "MinProtein": {
            "definition": "Minimum protein required",
            "shape": [],
            "type": "int"
        }
    },
    "objective": {
        "description": "\"The goal is to minimize the total sodium intake from consuming ramen and fries\"",
        "formulation": "$\\min \\left( \\text{SodiumPerRamenPack} \\cdot \\text{RamenPacks} + \\text{SodiumPerFriesPack} \\cdot \\text{FriesPacks} \\right)$",
        "code": "model.setObjective(\n    SodiumPerRamenPack * RamenPacks + SodiumPerFriesPack * FriesPacks,\n    GRB.MINIMIZE\n)"
    },
    "constraints": [
        {
            "description": "Total calories from ramen and fries must be at least MinCalories",
            "formulation": "$CaloriesPerRamenPack \\\\cdot RamenPacks + CaloriesPerFriesPack \\\\cdot FriesPacks \\\\geq MinCalories$",
            "code": "model.addConstr(CaloriesPerRamenPack * RamenPacks + CaloriesPerFriesPack * FriesPacks >= MinCalories)"
        },
        {
            "description": "Total protein from ramen and fries must be at least MinProtein",
            "formulation": "$ProteinPerRamenPack \\\\cdot RamenPacks + ProteinPerFriesPack \\\\cdot FriesPacks \\\\geq MinProtein$",
            "code": "model.addConstr(ProteinPerRamenPack * RamenPacks + ProteinPerFriesPack * FriesPacks >= MinProtein)"
        },
        {
            "description": "The number of ramen packs consumed must be at most MaxRamenMealRatio times the total number of packs consumed",
            "formulation": "$RamenPacks \\\\leq MaxRamenMealRatio \\\\cdot (RamenPacks + FriesPacks)$",
            "code": "model.addConstr(RamenPacks <= MaxRamenMealRatio * (RamenPacks + FriesPacks))"
        },
        {
            "description": "The number of ramen and fries packs consumed must be non-negative",
            "formulation": "$RamenPacks \\\\geq 0,\\\\; FriesPacks \\\\geq 0$",
            "code": "model.addConstr(RamenPacks >= 0)\nmodel.addConstr(FriesPacks >= 0)"
        }
    ],
    "variables": {
        "RamenPacks": {
            "shape": [],
            "type": "integer",
            "definition": "Number of ramen packs consumed"
        },
        "FriesPacks": {
            "shape": [],
            "type": "integer",
            "definition": "Number of fries packs consumed"
        }
    }
}