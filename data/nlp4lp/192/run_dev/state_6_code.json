{
    "description": "An office company makes desks and drawers. Each desk requires 40 minutes of assembly and 20 minutes of sanding. Each drawer requires 30 minutes of assembly and 10 minutes of sanding. The company has available 4000 minutes for assembly and 3500 minutes for sanding. If the profit per desk is $100 and the profit per drawer is $90, how many of each should the company make to maximize profit?",
    "parameters": {
        "AssemblyTimeDesk": {
            "definition": "Minutes required for assembly per desk",
            "shape": [],
            "type": "int"
        },
        "SandingTimeDesk": {
            "definition": "Minutes required for sanding per desk",
            "shape": [],
            "type": "int"
        },
        "AssemblyTimeDrawer": {
            "definition": "Minutes required for assembly per drawer",
            "shape": [],
            "type": "int"
        },
        "SandingTimeDrawer": {
            "definition": "Minutes required for sanding per drawer",
            "shape": [],
            "type": "int"
        },
        "TotalAssemblyTime": {
            "definition": "Total available assembly minutes",
            "shape": [],
            "type": "int"
        },
        "TotalSandingTime": {
            "definition": "Total available sanding minutes",
            "shape": [],
            "type": "int"
        },
        "ProfitPerDesk": {
            "definition": "Profit per desk",
            "shape": [],
            "type": "int"
        },
        "ProfitPerDrawer": {
            "definition": "Profit per drawer",
            "shape": [],
            "type": "int"
        }
    },
    "objective": {
        "description": "\"Maximize the total profit from producing desks and drawers\"",
        "formulation": "$\\max \\; ProfitPerDesk \\cdot NumDesks + ProfitPerDrawer \\cdot NumDrawers$",
        "code": ""
    },
    "constraints": [
        {
            "description": "40 * (number of desks) + 30 * (number of drawers) <= TotalAssemblyTime",
            "formulation": "$40 \\\\cdot NumDesks + 30 \\\\cdot NumDrawers \\\\leq TotalAssemblyTime$",
            "code": "model.addConstr(AssemblyTimeDesk * NumDesks + AssemblyTimeDrawer * NumDrawers <= TotalAssemblyTime)"
        },
        {
            "description": "20 * (number of desks) + 10 * (number of drawers) <= TotalSandingTime",
            "formulation": "$20 \\\\cdot NumDesks + 10 \\\\cdot NumDrawers \\\\leq TotalSandingTime$",
            "code": "model.addConstr(SandingTimeDesk * NumDesks + SandingTimeDrawer * NumDrawers <= TotalSandingTime)"
        },
        {
            "description": "Number of desks produced >= 0",
            "formulation": "$NumDesks \\\\geq 0$",
            "code": "model.addConstr(NumDesks >= 0)"
        },
        {
            "description": "Number of drawers produced >= 0",
            "formulation": "$NumDrawers \\\\ge 0$",
            "code": "model.addConstr(NumDrawers >= 0)"
        }
    ],
    "variables": {
        "NumDesks": {
            "shape": [],
            "type": "integer",
            "definition": "Number of desks to produce"
        },
        "NumDrawers": {
            "shape": [],
            "type": "integer",
            "definition": "Number of drawers to produce"
        }
    }
}