{
    "description": "The weather is freezing and the fish in the pond need to be transported either by helicopter or car. A helicopter can take 30 fish per trip and takes 40 minutes. A car can take 20 fish per trip and takes 30 minutes. Since helicopter trips are expensive, there can be at most 5 helicopter trips. In addition, at least 60% of the trips should be by car. If at least 300 fish need to transported, how many of each trip should be taken to minimize the total time needed?",
    "parameters": {
        "HelicopterCapacity": {
            "definition": "Number of fish a helicopter can transport per trip",
            "shape": [],
            "type": "int"
        },
        "HelicopterTime": {
            "definition": "Time a helicopter takes per trip in minutes",
            "shape": [],
            "type": "int"
        },
        "CarCapacity": {
            "definition": "Number of fish a car can transport per trip",
            "shape": [],
            "type": "int"
        },
        "CarTime": {
            "definition": "Time a car takes per trip in minutes",
            "shape": [],
            "type": "int"
        },
        "MaxHelicopterTrips": {
            "definition": "Maximum number of helicopter trips allowed",
            "shape": [],
            "type": "int"
        },
        "MinPercentageCarTrips": {
            "definition": "Minimum percentage of trips that must be by car",
            "shape": [],
            "type": "float"
        },
        "MinFishToTransport": {
            "definition": "Minimum number of fish to transport",
            "shape": [],
            "type": "int"
        }
    },
    "objective": {
        "description": "\"Minimize the total transportation time required to move at least 300 fish using helicopter and car trips\"",
        "formulation": "$\\min \\; HelicopterTime \\cdot HelicopterTrips + CarTime \\cdot CarTrips$",
        "code": "model.setObjective(HelicopterTime * HelicopterTrips + CarTime * CarTrips, GRB.MINIMIZE)"
    },
    "constraints": [
        {
            "description": "30 * HelicopterTrips + 20 * CarTrips >= 300",
            "formulation": "$HelicopterCapacity \\\\cdot HelicopterTrips + CarCapacity \\\\cdot CarTrips \\\\geq MinFishToTransport$",
            "code": "model.addConstr(HelicopterCapacity * HelicopterTrips + CarCapacity * CarTrips >= MinFishToTransport)"
        },
        {
            "description": "HelicopterTrips <= 5",
            "formulation": "$HelicopterTrips \\\\leq MaxHelicopterTrips$",
            "code": "model.addConstr(HelicopterTrips <= MaxHelicopterTrips)"
        },
        {
            "description": "CarTrips / (HelicopterTrips + CarTrips) >= 0.6",
            "formulation": "$2 \\\\, CarTrips \\\\geq 3 \\\\, HelicopterTrips$",
            "code": "model.addConstr(2 * CarTrips >= 3 * HelicopterTrips)"
        },
        {
            "description": "HelicopterTrips >= 0, CarTrips >= 0",
            "formulation": "$HelicopterTrips \\\\geq 0, \\\\; CarTrips \\\\geq 0$",
            "code": "model.addConstr(HelicopterTrips >= 0)\nmodel.addConstr(CarTrips >= 0)"
        },
        {
            "description": "HelicopterTrips and CarTrips are integers",
            "formulation": "$HelicopterTrips,\\\\; CarTrips \\\\in \\\\mathbb{Z}_{\\\\ge 0}$",
            "code": "model.addConstr(HelicopterTrips >= 0)\nmodel.addConstr(CarTrips >= 0)"
        }
    ],
    "variables": {
        "HelicopterTrips": {
            "shape": [],
            "type": "integer",
            "definition": "Number of helicopter trips taken"
        },
        "CarTrips": {
            "shape": [],
            "type": "integer",
            "definition": "Number of car trips taken"
        }
    }
}