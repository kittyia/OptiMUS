{
    "parametrized_description": "A farmer has TotalHectares hectares for growing tomatoes and potatoes. The tomato acreage cannot exceed MaxTomatoesToPotatoesRatio times the potato acreage. At least MinTomatoes hectares of tomatoes and MinPotatoes hectares of potatoes must be planted. Profit is ProfitPerHectareTomatoes per hectare of tomatoes and ProfitPerHectarePotatoes per hectare of potatoes. Maximize total profit.",
    "keywords": [
        "resource allocation",
        "agriculture",
        "linear programming"
    ],
    "parameters": {
        "TotalHectares": {
            "description": "Total available hectares for farming",
            "shape": []
        },
        "MinTomatoes": {
            "description": "Minimum hectares of tomatoes to meet community demands",
            "shape": []
        },
        "MinPotatoes": {
            "description": "Minimum hectares of potatoes to meet community demands",
            "shape": []
        },
        "MaxTomatoesToPotatoesRatio": {
            "description": "Maximum ratio of tomato hectares to potato hectares",
            "shape": []
        },
        "ProfitPerHectareTomatoes": {
            "description": "Profit per hectare of tomatoes",
            "shape": []
        },
        "ProfitPerHectarePotatoes": {
            "description": "Profit per hectare of potatoes",
            "shape": []
        }
    },
    "variables": {
        "HectaresTomatoes": {
            "description": "Hectares allocated to tomatoes",
            "type": "continuous",
            "shape": []
        },
        "HectaresPotatoes": {
            "description": "Hectares allocated to potatoes",
            "type": "continuous",
            "shape": []
        }
    },
    "constraints": [
        {
            "description": "Total hectares used must not exceed TotalHectares.",
            "formulation": "HectaresTomatoes + HectaresPotatoes \\leq TotalHectares",
            "code": {
                "gurobipy": "model.addConstr(HectaresTomatoes + HectaresPotatoes <= TotalHectares, name=\"TotalLand\")"
            }
        },
        {
            "description": "Tomato hectares must not exceed MaxTomatoesToPotatoesRatio times potato hectares.",
            "formulation": "HectaresTomatoes \\leq MaxTomatoesToPotatoesRatio \\times HectaresPotatoes",
            "code": {
                "gurobipy": "model.addConstr(HectaresTomatoes <= MaxTomatoesToPotatoesRatio * HectaresPotatoes, name=\"TomPotatoRatio\")"
            }
        },
        {
            "description": "At least MinTomatoes hectares must be planted with tomatoes.",
            "formulation": "HectaresTomatoes \\geq MinTomatoes",
            "code": {
                "gurobipy": "model.addConstr(HectaresTomatoes >= MinTomatoes, name=\"MinTom\")"
            }
        },
        {
            "description": "At least MinPotatoes hectares must be planted with potatoes.",
            "formulation": "HectaresPotatoes \\geq MinPotatoes",
            "code": {
                "gurobipy": "model.addConstr(HectaresPotatoes >= MinPotatoes, name=\"MinPot\")"
            }
        }
    ],
    "objective": {
        "description": "Maximize total profit from tomatoes and potatoes.",
        "formulation": "\\max \\ ProfitPerHectareTomatoes \\times HectaresTomatoes + ProfitPerHectarePotatoes \\times HectaresPotatoes",
        "code": {
            "gurobipy": "model.setObjective(ProfitPerHectareTomatoes * HectaresTomatoes + ProfitPerHectarePotatoes * HectaresPotatoes, GRB.MAXIMIZE)"
        }
    }
}
