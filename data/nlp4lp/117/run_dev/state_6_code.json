{
    "description": "A woman eats cashews and almonds to get her calorie and protein intake. A serving of almonds contains 200 calories and 20 grams of protein. A serving of cashews contains 300 calories and 25 grams of protein. The woman decides to eat at least twice as many servings of almonds as cashews. Furthermore, a serving of almonds contains 15 grams of fat while a serving of cashews contains 12 grams of fat. If the woman needs to consume at least 10000 calories and 800 grams of protein this week, how many servings of each should she eat to minimize her fat intake?",
    "parameters": {
        "NumNutTypes": {
            "definition": "Number of different nut types",
            "shape": [],
            "type": "int"
        },
        "CaloriePerServing": {
            "definition": "Calories in one serving of each nut type",
            "shape": [
                "NumNutTypes"
            ],
            "type": "string"
        },
        "ProteinPerServing": {
            "definition": "Protein in one serving of each nut type",
            "shape": [
                "NumNutTypes"
            ],
            "type": "string"
        },
        "FatPerServing": {
            "definition": "Fat in one serving of each nut type",
            "shape": [
                "NumNutTypes"
            ],
            "type": "string"
        },
        "ServingRatioMultiplier": {
            "definition": "Minimum ratio of servings of almonds to cashews",
            "shape": [],
            "type": "int"
        },
        "CalorieRequirement": {
            "definition": "Total calorie intake requirement",
            "shape": [],
            "type": "int"
        },
        "ProteinRequirement": {
            "definition": "Total protein intake requirement",
            "shape": [],
            "type": "int"
        }
    },
    "objective": {
        "description": "\"Minimize the total fat intake from consuming almonds and cashews\"",
        "formulation": "$\\min \\; FatPerServing_{1}\\, ServingsOfAlmonds \\;+\\; FatPerServing_{2}\\, ServingsOfCashews}$",
        "code": ""
    },
    "constraints": [
        {
            "description": "200 * ServingsOfAlmonds + 300 * ServingsOfCashews >= CalorieRequirement",
            "formulation": "$200 \\\\cdot ServingsOfAlmonds + 300 \\\\cdot ServingsOfCashews \\\\geq CalorieRequirement$",
            "code": "model.addConstr(200 * ServingsOfAlmonds + 300 * ServingsOfCashews >= CalorieRequirement)"
        },
        {
            "description": "20 * ServingsOfAlmonds + 25 * ServingsOfCashews >= ProteinRequirement",
            "formulation": "$20 \\\\cdot ServingsOfAlmonds + 25 \\\\cdot ServingsOfCashews \\\\geq ProteinRequirement$",
            "code": "model.addConstr(20 * ServingsOfAlmonds + 25 * ServingsOfCashews >= ProteinRequirement)"
        },
        {
            "description": "ServingsOfAlmonds >= ServingRatioMultiplier * ServingsOfCashews",
            "formulation": "$ServingsOfAlmonds \\\\geq ServingRatioMultiplier \\\\cdot ServingsOfCashews$",
            "code": "model.addConstr(ServingsOfAlmonds >= ServingRatioMultiplier * ServingsOfCashews)"
        },
        {
            "description": "ServingsOfAlmonds >= 0",
            "formulation": "$ServingsOfAlmonds \\\\ge 0$",
            "code": "model.addConstr(ServingsOfAlmonds >= 0)"
        },
        {
            "description": "ServingsOfCashews >= 0",
            "formulation": "$ServingsOfCashews \\\\geq 0$",
            "code": "model.addConstr(ServingsOfCashews >= 0)"
        }
    ],
    "variables": {
        "ServingsOfAlmonds": {
            "shape": [],
            "type": "continuous",
            "definition": "Number of servings of almonds consumed during the week"
        },
        "ServingsOfCashews": {
            "shape": [],
            "type": "continuous",
            "definition": "Number of servings of cashews consumed during the week"
        }
    }
}