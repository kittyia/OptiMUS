{
    "description": "A zookeeper feeds a gorilla with bananas and mangoes. Each banana contains 80 calories, 20 grams of potassium, and 10 grams of sugar. Each mango contains 100 calories, 15 grams of potassium, and 8 grams of sugar.  The gorilla must consume at least 4000 calories and 150 grams of potassium. Since the gorilla prefers bananas, at most 33% of the fruits he eats can be mangoes. If excess sugar makes the gorilla aggressive, how many of each fruit should he consume to minimize his sugar intake?",
    "parameters": {
        "CalorieBanana": {
            "definition": "Amount of calories per banana",
            "shape": [],
            "type": "int"
        },
        "CalorieMango": {
            "definition": "Amount of calories per mango",
            "shape": [],
            "type": "int"
        },
        "PotassiumBanana": {
            "definition": "Amount of potassium per banana",
            "shape": [],
            "type": "int"
        },
        "PotassiumMango": {
            "definition": "Amount of potassium per mango",
            "shape": [],
            "type": "int"
        },
        "SugarBanana": {
            "definition": "Amount of sugar per banana",
            "shape": [],
            "type": "int"
        },
        "SugarMango": {
            "definition": "Amount of sugar per mango",
            "shape": [],
            "type": "int"
        },
        "MinCalories": {
            "definition": "Minimum total calories required",
            "shape": [],
            "type": "int"
        },
        "MinPotassium": {
            "definition": "Minimum total potassium required",
            "shape": [],
            "type": "int"
        },
        "MaxMangoFraction": {
            "definition": "Maximum fraction of fruits that can be mangoes",
            "shape": [],
            "type": "float"
        }
    },
    "objective": {
        "description": "\"Minimize the total sugar intake from bananas and mangoes\"",
        "formulation": "$\\min \\; SugarBanana \\cdot Bananas + SugarMango \\cdot Mangoes$",
        "code": ""
    },
    "constraints": [
        {
            "description": "80 * Bananas + 100 * Mangoes >= 4000",
            "formulation": "$80 \\\\cdot Bananas + 100 \\\\cdot Mangoes \\\\geq 4000$",
            "code": "model.addConstr(CalorieBanana * Bananas + CalorieMango * Mangoes >= MinCalories)"
        },
        {
            "description": "Mangoes / (Bananas + Mangoes) <= 0.33",
            "formulation": "$Mangoes \\\\leq 0.33 (Bananas + Mangoes)$",
            "code": "model.addConstr(Mangoes <= MaxMangoFraction * (Bananas + Mangoes))"
        },
        {
            "description": "Bananas >= 0",
            "formulation": "$Bananas \\\\geq 0$",
            "code": "model.addConstr(Bananas >= 0)"
        },
        {
            "description": "Mangoes >= 0",
            "formulation": "$Mangoes \\\\geq 0$",
            "code": "model.addConstr(Mangoes >= 0)"
        }
    ],
    "variables": {
        "Bananas": {
            "shape": [],
            "type": "integer",
            "definition": "Number of bananas consumed by the gorilla"
        },
        "Mangoes": {
            "shape": [],
            "type": "integer",
            "definition": "Number of mangoes consumed by the gorilla"
        }
    }
}