{
    "description": "A zookeeper feeds a gorilla with bananas and mangoes. Each banana contains 80 calories, 20 grams of potassium, and 10 grams of sugar. Each mango contains 100 calories, 15 grams of potassium, and 8 grams of sugar.  The gorilla must consume at least 4000 calories and 150 grams of potassium. Since the gorilla prefers bananas, at most 33% of the fruits he eats can be mangoes. If excess sugar makes the gorilla aggressive, how many of each fruit should he consume to minimize his sugar intake?",
    "parameters": {
        "CalorieBanana": {
            "definition": "Amount of calories per banana",
            "shape": [],
            "type": "int"
        },
        "CalorieMango": {
            "definition": "Amount of calories per mango",
            "shape": [],
            "type": "int"
        },
        "PotassiumBanana": {
            "definition": "Amount of potassium per banana",
            "shape": [],
            "type": "int"
        },
        "PotassiumMango": {
            "definition": "Amount of potassium per mango",
            "shape": [],
            "type": "int"
        },
        "SugarBanana": {
            "definition": "Amount of sugar per banana",
            "shape": [],
            "type": "int"
        },
        "SugarMango": {
            "definition": "Amount of sugar per mango",
            "shape": [],
            "type": "int"
        },
        "MinCalories": {
            "definition": "Minimum total calories required",
            "shape": [],
            "type": "int"
        },
        "MinPotassium": {
            "definition": "Minimum total potassium required",
            "shape": [],
            "type": "int"
        },
        "MaxMangoFraction": {
            "definition": "Maximum fraction of fruits that can be mangoes",
            "shape": [],
            "type": "float"
        }
    },
    "objective": {
        "description": "\"Minimize the gorilla's total sugar intake from bananas and mangoes\"",
        "formulation": "$\\min \\; SugarBanana \\cdot NumberOfBananas + SugarMango \\cdot NumberOfMangoes$"
    },
    "constraints": [
        {
            "description": "80 * NumberOfBananas + 100 * NumberOfMangoes >= 4000",
            "formulation": "$80 \\\\cdot NumberOfBananas + 100 \\\\cdot NumberOfMangoes \\\\geq 4000$",
            "code": null
        },
        {
            "description": "NumberOfMangoes <= MaxMangoFraction * (NumberOfBananas + NumberOfMangoes)",
            "formulation": "$NumberOfMangoes \\\\leq MaxMangoFraction \\\\cdot (NumberOfBananas + NumberOfMangoes)$",
            "code": null
        },
        {
            "description": "NumberOfBananas >= 0",
            "formulation": "$NumberOfBananas \\\\geq 0$",
            "code": null
        },
        {
            "description": "NumberOfMangoes >= 0",
            "formulation": "$NumberOfMangoes \\\\ge 0$",
            "code": null
        }
    ],
    "variables": {
