{
    "description": "A drug company is making pain killers and sleeping pills using two processes, process 1 and process 2. Process 1 produces 35 units of pain killers and 12 units of sleeping pills per hour. Process 2 produces 50 units of pain killers and 30 units of sleeping pills per hour. Process 1 requires 50 units of preliminary material while process 2 requires 60 units of preliminary material. The drug company has available 2000 units of preliminary material and must make at least 1200 units of pain killers and 1200 units of sleeping pills. How many of each process should be run to minimize the total time needed?",
    "parameters": {
        "NumProcesses": {
            "definition": "NumProcesses",
            "shape": [],
            "type": "int"
        },
        "NumProducts": {
            "definition": "NumProducts",
            "shape": [],
            "type": "int"
        },
        "ProductionRate": {
            "definition": "ProductionRate",
            "shape": [
                2,
                2
            ],
            "type": "string"
        },
        "PreliminaryMaterialRequired": {
            "definition": "PreliminaryMaterialRequired",
            "shape": [
                2
            ],
            "type": "string"
        },
        "TotalPreliminaryMaterialAvailable": {
            "definition": "TotalPreliminaryMaterialAvailable",
            "shape": [],
            "type": "int"
        },
        "MinProductRequired": {
            "definition": "MinProductRequired",
            "shape": [
                2
            ],
            "type": "string"
        }
    },
    "objective": {
        "description": "\"Minimize the total time required to run process 1 and process 2 to meet production and material constraints\"",
        "formulation": "$\\min \\sum_{i=1}^{\\text{NumProcesses}} \\text{ProcessTime}_i$"
    },
    "constraints": [
        {
            "description": "50 * x1 + 60 * x2 <= 2000",
            "formulation": "$\\\\sum_{p=1}^{NumProcesses} PreliminaryMaterialRequired[p] \\\\cdot ProcessTime[p] \\\\leq TotalPreliminaryMaterialAvailable$",
            "code": null
        },
        {
            "description": "35 * x1 + 50 * x2 >= 1200",
            "formulation": "$35 \\\\, ProcessTime[1] + 50 \\\\, ProcessTime[2] \\\\geq 1200$",
            "code": null
        },
        {
            "description": "12 * x1 + 30 * x2 >= 1200",
            "formulation": "$\\\\sum_{p=1}^{NumProcesses} ProductionRate[p,2] \\\\cdot ProcessTime[p] \\\\geq MinProductRequired[2]$",
            "code": null
        },
        {
            "description": "x1 >= 0",
            "formulation": "$ProcessTime[1] \\\\geq 0$",
            "code": null
        },
        {
            "description": "x2 >= 0",
            "formulation": "$ProcessTime[2] \\\\geq 0$",
            "code": null
        }
    ],
    "variables": {
        "ProcessTime": {
            "shape": [
                "NumProcesses"
            ],
            "type": "continuous",
            "definition": "The number of hours each process is run"
        }
    }
}