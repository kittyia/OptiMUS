{
    "description": "A municipality hires full-time and part-time staff to deliver mail. Part-time staff works 15 hours per week and gets paid 450 dollars whereas a full-time staff works 40 hours every week and gets paid 1280 dollars  for that week.  Since it is the week leading up to a holiday, planning ahead, the municipality needs 1000 hours of mail staff labor. The municipality has a budget of 31500 dollars for mail delivery for this season. How many of each type of staff should the municipality hire to decrease the total number of staff?",
    "parameters": {
        "PartTimeHours": {
            "definition": "Part-time staff weekly working hours",
            "shape": [],
            "type": "int"
        },
        "PartTimeWage": {
            "definition": "Part-time staff weekly wage",
            "shape": [],
            "type": "int"
        },
        "FullTimeHours": {
            "definition": "Full-time staff weekly working hours",
            "shape": [],
            "type": "int"
        },
        "FullTimeWage": {
            "definition": "Full-time staff weekly wage",
            "shape": [],
            "type": "int"
        },
        "TotalHoursRequired": {
            "definition": "Total weekly working hours required",
            "shape": [],
            "type": "int"
        },
        "TotalBudget": {
            "definition": "Total budget for mail delivery",
            "shape": [],
            "type": "int"
        }
    },
    "objective": {
        "description": "\"Minimize the total number of staff hired (full-time and part-time combined)\"",
        "formulation": "$\\min \\; PartTimeStaff + FullTimeStaff$",
        "code": "model.setObjective(PartTimeStaff + FullTimeStaff, GRB.MINIMIZE)"
    },
    "constraints": [
        {
            "description": "15 * (Number of part-time staff) + 40 * (Number of full-time staff) >= 1000",
            "formulation": "$PartTimeHours \\\\cdot PartTimeStaff + FullTimeHours \\\\cdot FullTimeStaff \\\\geq TotalHoursRequired$",
            "code": "model.addConstr(PartTimeHours * PartTimeStaff + FullTimeHours * FullTimeStaff >= TotalHoursRequired)"
        },
        {
            "description": "450 * (Number of part-time staff) + 1280 * (Number of full-time staff) <= 31500",
            "formulation": "$450 \\\\cdot PartTimeStaff + 1280 \\\\cdot FullTimeStaff \\\\leq 31500$",
            "code": "model.addConstr(PartTimeWage * PartTimeStaff + FullTimeWage * FullTimeStaff <= TotalBudget)"
        },
        {
            "description": "Number of part-time staff >= 0, Number of full-time staff >= 0",
            "formulation": "$PartTimeStaff \\\\geq 0, \\\\; FullTimeStaff \\\\geq 0$",
            "code": "model.addConstr(PartTimeStaff >= 0)\nmodel.addConstr(FullTimeStaff >= 0)"
        },
        {
            "description": "Number of part-time staff and number of full-time staff must be integers",
            "formulation": "$PartTimeStaff \\\\in \\\\mathbb{Z}_{\\\\geq 0}, \\\\; FullTimeStaff \\\\in \\\\mathbb{Z}_{\\\\geq 0}$",
            "code": "model.addConstr(PartTimeStaff >= 0)\nmodel.addConstr(FullTimeStaff >= 0)"
        }
    ],
    "variables": {
        "PartTimeStaff": {
            "shape": [],
            "type": "integer",
            "definition": "Number of part-time staff hired"
        },
        "FullTimeStaff": {
            "shape": [],
            "type": "integer",
            "definition": "Number of full-time staff hired"
        }
    }
}