{
    "description": "A farmer has TotalAcres available for growing apples and pears. The farmer must allocate at least MinApplesAcres to apples and at least MinPearsAcres to pears. The profit per acre of apples is ProfitPerAcreApples and the profit per acre of pears is ProfitPerAcrePears. Additionally, the total acreage used for apples and pears combined should not exceed TotalAcres, and the farmer can grow at most MaxPearsToApplesRatio times the amount of pears as apples. How many acres should be allocated to each fruit to maximize profit, and what is that maximum profit?",
    "parameters": {
        "TotalAcres": {
            "definition": "Total available acres for growing",
            "shape": [],
            "type": "int"
        },
        "MinApplesAcres": {
            "definition": "Minimum acres allocated to apples",
            "shape": [],
            "type": "int"
        },
        "MinPearsAcres": {
            "definition": "Minimum acres allocated to pears",
            "shape": [],
            "type": "int"
        },
        "ProfitPerAcreApples": {
            "definition": "Profit per acre of apples",
            "shape": [],
            "type": "int"
        },
        "ProfitPerAcrePears": {
            "definition": "Profit per acre of pears",
            "shape": [],
            "type": "int"
        },
        "MaxPearsToApplesRatio": {
            "definition": "Maximum ratio of pear acreage to apple acreage",
            "shape": [],
            "type": "int"
        }
    },
    "objective": {
        "description": "\"Maximize the total profit from allocating acres to apples and pears\"",
        "formulation": "$\\max \\; ProfitPerAcreApples \\cdot AcresApples + ProfitPerAcrePears \\cdot AcresPears$",
        "code": ""
    },
    "constraints": [
        {
            "description": "AcresApples >= MinApplesAcres",
            "formulation": "$AcresApples \\\\geq MinApplesAcres$",
            "code": "model.addConstr(AcresApples >= MinApplesAcres)"
        },
        {
            "description": "AcresPears >= MinPearsAcres",
            "formulation": "$AcresPears \\\\geq MinPearsAcres$",
            "code": "model.addConstr(AcresPears >= MinPearsAcres)"
        },
        {
            "description": "AcresApples + AcresPears <= TotalAcres",
            "formulation": "$AcresApples + AcresPears \\\\leq TotalAcres$",
            "code": "model.addConstr(AcresApples + AcresPears <= TotalAcres)"
        },
        {
            "description": "AcresPears <= MaxPearsToApplesRatio * AcresApples",
            "formulation": "$AcresPears \\\\leq MaxPearsToApplesRatio \\\\cdot AcresApples$",
            "code": "model.addConstr(AcresPears <= MaxPearsToApplesRatio * AcresApples)"
        }
    ],
    "variables": {
        "AcresApples": {
            "shape": [],
            "type": "continuous",
            "definition": "Number of acres allocated to growing apples"
        },
        "AcresPears": {
            "shape": [],
            "type": "continuous",
            "definition": "Number of acres allocated to growing pears"
        }
    }
}