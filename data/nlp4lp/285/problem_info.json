{
    "parametrized_description": "A farmer has TotalAcres acres available for growing apples and pears. At least MinApplesAcres must be allocated to apples and MinPearsAcres to pears. The profit per acre is ProfitPerAcreApples for apples and ProfitPerAcrePears for pears. The pear acreage cannot exceed MaxPearsToApplesRatio times the apple acreage. Determine the allocation to maximize profit.",
    "keywords": [
        "resource allocation",
        "agriculture",
        "linear programming"
    ],
    "parameters": {
        "TotalAcres": {
            "description": "Total available acres for growing",
            "shape": []
        },
        "MinApplesAcres": {
            "description": "Minimum acres allocated to apples",
            "shape": []
        },
        "MinPearsAcres": {
            "description": "Minimum acres allocated to pears",
            "shape": []
        },
        "ProfitPerAcreApples": {
            "description": "Profit per acre of apples",
            "shape": []
        },
        "ProfitPerAcrePears": {
            "description": "Profit per acre of pears",
            "shape": []
        },
        "MaxPearsToApplesRatio": {
            "description": "Maximum ratio of pear acreage to apple acreage",
            "shape": []
        }
    },
    "variables": {
        "AcresApples": {
            "description": "Acres allocated to apples",
            "type": "continuous",
            "shape": []
        },
        "AcresPears": {
            "description": "Acres allocated to pears",
            "type": "continuous",
            "shape": []
        }
    },
    "constraints": [
        {
            "description": "Total acreage must not exceed TotalAcres.",
            "formulation": "AcresApples + AcresPears \\leq TotalAcres",
            "code": {
                "gurobipy": "model.addConstr(AcresApples + AcresPears <= TotalAcres, name=\"TotalLand\")"
            }
        },
        {
            "description": "At least MinApplesAcres must be allocated to apples.",
            "formulation": "AcresApples \\geq MinApplesAcres",
            "code": {
                "gurobipy": "model.addConstr(AcresApples >= MinApplesAcres, name=\"MinApples\")"
            }
        },
        {
            "description": "At least MinPearsAcres must be allocated to pears.",
            "formulation": "AcresPears \\geq MinPearsAcres",
            "code": {
                "gurobipy": "model.addConstr(AcresPears >= MinPearsAcres, name=\"MinPears\")"
            }
        },
        {
            "description": "Pear acreage cannot exceed MaxPearsToApplesRatio times apple acreage.",
            "formulation": "AcresPears \\leq MaxPearsToApplesRatio \\times AcresApples",
            "code": {
                "gurobipy": "model.addConstr(AcresPears <= MaxPearsToApplesRatio * AcresApples, name=\"PearAppleRatio\")"
            }
        }
    ],
    "objective": {
        "description": "Maximize total profit from apples and pears.",
        "formulation": "\\max \\ ProfitPerAcreApples \\times AcresApples + ProfitPerAcrePears \\times AcresPears",
        "code": {
            "gurobipy": "model.setObjective(ProfitPerAcreApples * AcresApples + ProfitPerAcrePears * AcresPears, GRB.MAXIMIZE)"
        }
    }
}
