        },
        "SleepPerNightPill": {
            "definition": "SleepPerNightPill",
            "shape": [],
            "type": "int"
        },
        "MinDayPillPercentage": {
            "definition": "MinDayPillPercentage",
            "shape": [],
            "type": "float"
        },
        "MinNightPills": {
            "definition": "MinNightPills",
            "shape": [],
            "type": "int"
        }
    },
    "objective": {
        "description": "\"Minimize the total amount of sleep medicine used in producing the daytime and nighttime pills\"",
        "formulation": null,
        "code": null
    },
    "constraints": [
        {
            "description": "6 * DayPills + 5 * NightPills <= TotalPainkillerUnits",
            "formulation": "$6 DayPills + 5 NightPills \\\\leq TotalPainkillerUnits$",
            "code": null
        },
        {
            "description": "DayPills >= MinDayPillPercentage * (DayPills + NightPills)",
            "formulation": "$DayPills \\\\geq MinDayPillPercentage \\\\cdot (DayPills + NightPills)$",
            "code": null
        },
        {
            "description": "NightPills >= MinNightPills",
            "formulation": "$NightPills \\\\geq MinNightPills$",
            "code": null
        }
    ],
    "variables": {
