{
    "description": "A car manufacturer makes two versions of the same car, a regular model and a premium model. They make x1 regular models per day and x2 premium models per day. The profit per regular model is $5000 and the profit per premium model is $8500 (x1 and x2 are unknown values both greater than or equal to 0). The daily demand for these cars is limited to and most 8 regular models and 6 premium models. In addition, the manufacturer can make a maximum of 12 cars of either type per day. How many cars of each model should the manufacturer make in order to maximize profit?",
    "parameters": {
        "ProfitRegular": {
            "definition": "Profit per regular model",
            "shape": [],
            "type": "int"
        },
        "ProfitPremium": {
            "definition": "Profit per premium model",
            "shape": [],
            "type": "int"
        },
        "DemandRegular": {
            "definition": "Daily demand for regular models",
            "shape": [],
            "type": "int"
        },
        "DemandPremium": {
            "definition": "Daily demand for premium models",
            "shape": [],
            "type": "int"
        },
        "MaxCarsTotal": {
            "definition": "Maximum number of cars that can be made per day",
            "shape": [],
            "type": "int"
        }
    },
    "objective": {
        "description": "\"Maximize the total daily profit from producing regular and premium car models\"",
        "formulation": "$\\max \\; ProfitRegular \\cdot x1 + ProfitPremium \\cdot x2$",
        "code": "model.setObjective(ProfitRegular * x1 + ProfitPremium * x2, GRB.MAXIMIZE)"
    },
    "constraints": [
        {
            "description": "x1 >= 0",
            "formulation": "$x1 \\\\geq 0$",
            "code": "model.addConstr(x1 >= 0)"
        },
        {
            "description": "x2 >= 0",
            "formulation": "$x2 \\\\geq 0$",
            "code": "model.addConstr(x2 >= 0)"
        },
        {
            "description": "x1 <= DemandRegular",
            "formulation": "$x1 \\\\leq DemandRegular$",
            "code": "model.addConstr(x1 <= DemandRegular)"
        },
        {
            "description": "x2 <= DemandPremium",
            "formulation": "$x2 \\\\leq DemandPremium$",
            "code": "model.addConstr(x2 <= DemandPremium)"
        },
        {
            "description": "x1 + x2 <= MaxCarsTotal",
            "formulation": "$x1 + x2 \\\\leq MaxCarsTotal$",
            "code": "model.addConstr(x1 + x2 <= MaxCarsTotal)"
        }
    ],
    "variables": {
        "x1": {
            "shape": [],
            "type": "continuous",
            "definition": "Number of regular models produced per day"
        },
        "x2": {
            "shape": [],
            "type": "continuous",
            "definition": "Number of premium models produced per day"
        }
    }
}