{
    "description": "A breakfast joint makes two different sandwiches: a regular and a special. Both need eggs and bacon. Each regular sandwich requires 2 eggs and 3 slices of bacon. Each special sandwich requires 3 eggs and 5 slices of bacon. The joint has a total of 40 eggs and 70 slices of bacon. It makes a profit of $3 per regular sandwich and a profit of $4 per special sandwich. How many of each sandwich should be made to maximize profit?",
    "parameters": {
        "NumSandwichTypes": {
            "definition": "Number of different sandwich types",
            "shape": [],
            "type": "int"
        },
        "NumIngredients": {
            "definition": "Number of different ingredients",
            "shape": [],
            "type": "int"
        },
        "Required": {
            "definition": "Amount of ingredient j required to produce one unit of sandwich i",
            "shape": [
                "NumIngredients",
                "NumSandwichTypes"
            ],
            "type": "string"
        },
        "TotalAvailable": {
            "definition": "Total availability of ingredient j",
            "shape": [
                "NumIngredients"
            ],
            "type": "string"
        },
        "ProfitPerSandwich": {
            "definition": "Profit per unit of sandwich i",
            "shape": [
                "NumSandwichTypes"
            ],
            "type": "string"
        }
    },
    "objective": {
        "description": "\"The goal is to maximize the total profit from producing regular and special sandwiches\"",
        "formulation": "$\\max \\; 3 \\, RegularSandwiches + 4 \\, SpecialSandwiches$",
        "code": ""
    },
    "constraints": [
        {
            "description": "2 * RegularSandwiches + 3 * SpecialSandwiches <= 40 (Egg availability constraint)",
            "formulation": "$2 \\\\cdot RegularSandwiches + 3 \\\\cdot SpecialSandwiches \\\\leq 40$",
            "code": "model.addConstr(2 * RegularSandwiches + 3 * SpecialSandwiches <= 40)"
        },
        {
            "description": "RegularSandwiches >= 0",
            "formulation": "$RegularSandwiches \\\\ge 0$",
            "code": "model.addConstr(RegularSandwiches >= 0)"
        },
        {
            "description": "SpecialSandwiches >= 0",
            "formulation": "$SpecialSandwiches \\\\geq 0$",
            "code": "model.addConstr(SpecialSandwiches >= 0)"
        }
    ],
    "variables": {
        "RegularSandwiches": {
            "shape": [],
            "type": "integer",
            "definition": "Number of regular sandwiches produced"
        },
        "SpecialSandwiches": {
            "shape": [],
            "type": "integer",
            "definition": "Number of special sandwiches produced"
        }
    }
}